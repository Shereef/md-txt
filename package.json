{
    "name": "md-txt",
    "version": "0.0.0-development",
    "description": "Uses `markdown-to-txt` by ejrbuss to create a cli for converting markdown to text",
    "main": "dist/cli.js",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/shereef/md-txt"
    },
    "author": {
        "name": "Shereef Marzouk",
        "url": "http://github.com/shereef",
        "email": "md-txt+pkgjson@shereef.net"
    },
    "bin": {
        "markdown-to-text": "dist/cli.js",
        "md-to-txt": "dist/cli.js",
        "md-txt": "dist/cli.js"
    },
    "engines": {
        "node": ">=8"
    },
    "scripts": {
        "format": "prettier --write . --ignore-path .gitignore",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix && npm run format:check",
        "format:check": "prettier --check . --ignore-path .gitignore --ignore-unknown",
        "build": "tsc",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "test:verbose": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --verbose --coverage",
        "prepare": "husky",
        "semantic-release": "semantic-release",
        "commit-check": "npm run format && npm run lint && npm run test:verbose"
    },
    "files": [
        "dist/cli.js",
        "LICENSE"
    ],
    "keywords": [
        "mg",
        "markdown",
        "markdown-text",
        "markdown-to-text",
        "md-txt",
        "md-to-txt",
        "text",
        "convert",
        "cli",
        "file"
    ],
    "bugs": {
        "url": "https://github.com/Shereef/md-txt/issues"
    },
    "homepage": "https://github.com/Shereef/md-txt#readme",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "lodash": "^4.18.1",
        "markdown-to-txt": "^2.0.1",
        "meow": "^14.1.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.0.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "husky": "^9.1.7",
        "jest": "^30.5.1",
        "prettier": "^3.9.6",
        "semantic-release": "^25.0.9",
        "ts-jest": "^29.4.12",
        "typescript": "^5.7.3"
    }
}
